{
  "name": "@genro/builders",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "exports": "./src/index.js",
  "imports": {
    "@jsr/genro__bag": "jsr:@genro/bag@^0.9.0",
    "@jsr/genro__tytx": "jsr:@genro/tytx@^0.16.0"
  },
  "publish": {
    "include": [
      "src/**",
      "package.json",
      "README.md",
      "LICENSE",
      "NOTICE"
    ]
  },
  "nodeModulesDir": "auto",
  "lock": false,
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@genro/*",
      "npm:@jsr/genro__*",
      "jsr:@genro/bag",
      "npm:@jsr/genro__bag",
      "jsr:@genro/tytx",
      "npm:@jsr/genro__tytx"
    ]
  }
}
