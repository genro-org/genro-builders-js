{
  "name": "@genro/builders",
  "version": "0.4.1",
  "license": "Apache-2.0",
  "exports": "./src/index.js",
  "imports": {
    "@genrojs/bag": "jsr:@genro/bag@^0.10.1",
    "@genrojs/tytx": "jsr:@genro/tytx@^0.16.1"
  },
  "publish": {
    "include": [
      "src/**",
      "package.json",
      "README.md",
      "LICENSE",
      "NOTICE"
    ]
  },
  "nodeModulesDir": "auto",
  "lock": false,
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@genro/*",
      "jsr:@genro/bag",
      "jsr:@genro/tytx",
      "npm:@genrojs/*",
      "npm:@genrojs/bag",
      "npm:@genrojs/tytx"
    ]
  }
}
